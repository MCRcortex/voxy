#version 460

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic: require

#define WORK_SIZE 256

//Does inital parralel prefix sum on batches of WORK_SIZE
layout(local_size_x=WORK_SIZE) in;

layout(binding = IO_BUFFER, std430) buffer InputBuffer {
    uvec4[] ioCount;
};

shared uint subgroupTotals[WORK_SIZE];//One per subgroup, sized for any subgroup size

void main() {
    //Dont trust gl_SubgroupSize/gl_SubgroupID/gl_NumSubgroups, mesa intel reports gl_SubgroupSize=32 while running this 16 wide
    // and gl_SubgroupID is broken on some intel drivers, so derive the real size from the active lanes instead
    // (all lanes are active here as WORK_SIZE is a multiple of any subgroup size)
    //This assumes subgroups are made of consecutive invocations, which the subgroup scan below requires anyway
    uint subgroupSize = subgroupAdd(1u);
    uint subgroupId = gl_LocalInvocationID.x/subgroupSize;

    uint gid = gl_GlobalInvocationID.x;
    uvec4 count = uvec4(0);
    uint sum = 0;
    {
        uvec4 dat = ioCount[gid];
        count.yzw = dat.xyz;
        count.z += count.y;
        count.w += count.z;
        sum = count.w + dat.w;
    }

    count += subgroupExclusiveAdd(sum);
    uint subgroupTotal = subgroupAdd(sum);
    if (subgroupElect()) {
        subgroupTotals[subgroupId] = subgroupTotal;
    }

    memoryBarrierShared();
    barrier();

    //Sum the totals of all preceding subgroups, each lane loads one of them and then reduce across the subgroup
    // the loop condition is uniform within the subgroup so the reduction is never in divergent control flow
    uint base = 0;
    for (uint i = 0; i < subgroupId; i += subgroupSize) {
        uint idx = i + gl_SubgroupInvocationID;
        if (idx < subgroupId) {
            base += subgroupTotals[idx];
        }
    }
    base = subgroupAdd(base);
    ioCount[gid] = count + base;
}
